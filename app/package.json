{
  "name": "the-masterwork-vault",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": "24.x" },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "predev": "npm run prebuild",
    "dev": "vite",
    "prebuild": "npm run verify:sources && node scripts/precompile-catalog.mjs",
    "verify:sources": "node --experimental-strip-types scripts/verify-material-sources.mjs && node --experimental-strip-types scripts/verify-material-source-search.mjs",
    "verify:recipes": "node scripts/verify-material-recipes.mjs",
    "verify:knowledge": "node scripts/verify-knowledge.mjs",
    "test:domain": "node --experimental-strip-types scripts/verify-domain-math.mjs",
    "verify:release": "npm run verify:recipes && npm run verify:knowledge && npm run test:domain && npm run verify:journey && npm run verify:reference",
    "build": "npm run verify:release && tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "test:quality": "npm run test:e2e",
    "verify:journey": "node --experimental-strip-types scripts/verify-journey.mjs",
    "verify:reference": "node --experimental-strip-types scripts/verify-profession-reference.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0", "lucide-react": "1.46.0", "react": "19.3.0", "react-dom": "19.3.0", "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@types/three": "0.186.0", "@vitejs/plugin-react": "6.0.4", "typescript": "7.0.2", "vite": "8.1.5"
  }
}
