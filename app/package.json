{
  "name": "the-masterwork-vault",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/precompile-catalog.mjs && node scripts/apply-quality-fixes.mjs && node scripts/apply-next-level-integration.mjs",
    "verify:recipes": "node scripts/verify-material-recipes.mjs",
    "verify:knowledge": "node scripts/verify-knowledge.mjs",
    "test:domain": "node --experimental-strip-types scripts/verify-domain-math.mjs",
    "verify:release": "npm run verify:recipes && npm run verify:knowledge && npm run test:domain",
    "build": "npm run verify:release && tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "test:quality": "npm run test:e2e"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
